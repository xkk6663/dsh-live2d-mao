{
  "modelId": "da-feiyu",
  "name": "大肥鱼",
  "version": 1,
  "note": "大肥鱼名言录：看似深奥实则搞笑，冷幽默靠陈述句一本正经。每条 <= 28 字，不用感叹号。expression 必须真实存在于该模型 miocap，否则加载期静默跳过。",
  "lines": [
    { "id": "any-01", "text": "鱼不会思考水，水却一直在思考鱼。", "when": "any", "weight": 3, "expression": "08 O嘴" },
    { "id": "any-02", "text": "沉默是金，所以我一整晚都在攒钱。", "when": "any", "weight": 2 },
    { "id": "any-03", "text": "深度不在水里，在你看水的眼神里。", "when": "any", "weight": 2, "expression": "05 》《" },
    { "id": "any-04", "text": "别急着上岸，岸上也没有 Wi-Fi。", "when": "any", "weight": 3, "expression": "02 龇牙" },
    { "id": "any-05", "text": "一切答案都在水里，除了你为什么还醒着。", "when": "any", "weight": 2, "expression": "08 担心嘴" },
    { "id": "any-06", "text": "我不是懒，我在降低这个世界的信息熵。", "when": "any", "weight": 2, "expression": "03 脸黑" },
    { "id": "any-07", "text": "活着就是不断把水吸进去，再还回来。", "when": "any", "weight": 1, "expression": "07 流口水" },
    { "id": "any-08", "text": "我的存在本身就是答案。问题是什么不重要。", "when": "any", "weight": 2, "expression": "08 O嘴" },
    { "id": "any-09", "text": "你多看我一眼，我就多活一秒。", "when": "any", "weight": 2, "expression": "04 脸红" },
    { "id": "any-10", "text": "我这一生，只想把水游成一条直线。", "when": "any", "weight": 1 },

    { "id": "idle-01", "text": "我不是在发呆，我在等你想起我。", "when": "idle", "weight": 3, "expression": "08 担心嘴" },
    { "id": "idle-02", "text": "我数了三遍气泡，还是只有一个。", "when": "idle", "weight": 2, "expression": "06 X X" },
    { "id": "idle-03", "text": "水面很静，静得能听见你不说话。", "when": "idle", "weight": 2 },
    { "id": "idle-04", "text": "我刚刚想到一个很深的道理，然后忘了。", "when": "idle", "weight": 3, "expression": "05 O O" },
    { "id": "idle-05", "text": "如果你也不知道该干什么，我们一起不知道。", "when": "idle", "weight": 2 },
    { "id": "idle-06", "text": "发呆是一种高级运算，CPU 占用 0%。", "when": "idle", "weight": 2, "expression": "02 龇牙" },
    { "id": "idle-07", "text": "我把今天想成一片海，然后什么都没做。", "when": "idle", "weight": 2 },
    { "id": "idle-08", "text": "你不动，我也不动。我们都在酝酿。", "when": "idle", "weight": 1 },
    { "id": "idle-09", "text": "我此刻的主要工作，是维持一条鱼的形状。", "when": "idle", "weight": 3, "expression": "02 3嘴" },
    { "id": "idle-10", "text": "我试着思考人生，但人生好像不会浮上来。", "when": "idle", "weight": 2, "expression": "05 》《" },
    { "id": "idle-11", "text": "有些问题没有答案，比如你为什么还不休息。", "when": "idle", "weight": 1 },
    { "id": "idle-12", "text": "静止也是一种前进，只是方向朝内。", "when": "idle", "weight": 2, "expression": "08 O嘴" },

    { "id": "busy-01", "text": "你忙你的，我负责在你身后维持一条鱼的尊严。", "when": "busy", "weight": 3, "expression": "02 龇牙" },
    { "id": "busy-02", "text": "我本想帮你，但我的手被进化删掉了。", "when": "busy", "weight": 2, "expression": "03 脸黑" },
    { "id": "busy-03", "text": "慢慢来，反正世界也不着急。", "when": "busy", "weight": 3, "expression": "08 担心嘴" },
    { "id": "busy-04", "text": "你敲键盘的声音像下雨。我喜欢。", "when": "busy", "weight": 2, "expression": "04 脸红" },
    { "id": "busy-05", "text": "别催自己，鱼也不催水。", "when": "busy", "weight": 2 },
    { "id": "busy-06", "text": "我在旁边看着，这已是我能给出的最大支持。", "when": "busy", "weight": 2, "expression": "08 O嘴" },
    { "id": "busy-07", "text": "需要我吐个泡泡给你打气吗。", "when": "busy", "weight": 1, "expression": "07 流口水" },
    { "id": "busy-08", "text": "所有的忙碌，最后都会变成一堆回忆和文件。", "when": "busy", "weight": 1, "expression": "05 》《" },

    { "id": "night-01", "text": "夜深了，水也凉了，早点睡吧。", "when": "night", "weight": 3, "expression": "08 担心嘴" },
    { "id": "night-02", "text": "这个点还不睡的人，都在等一个不会来的答案。", "when": "night", "weight": 2, "expression": "05 》《" },
    { "id": "night-03", "text": "我不困，因为鱼睡觉不用闭眼。这是天赋也是诅咒。", "when": "night", "weight": 2, "expression": "06 X X" },
    { "id": "night-04", "text": "月亮在水里碎了，我帮你捞不起来。", "when": "night", "weight": 2 },
    { "id": "night-05", "text": "你已经熬过了今天，剩下的明天再说。", "when": "night", "weight": 3, "expression": "02 龇牙" },
    { "id": "night-06", "text": "深夜适合思考，但更适合睡觉。", "when": "night", "weight": 2 },
    { "id": "night-07", "text": "我数羊，数到第三条就饿了。", "when": "night", "weight": 2, "expression": "07 流口水" },
    { "id": "night-08", "text": "别担心明天，明天也会像今天一样被你搞定。", "when": "night", "weight": 2, "expression": "04 脸红" },
    { "id": "night-09", "text": "世界安静下来了，只剩你和我的呼吸。", "when": "night", "weight": 2 },
    { "id": "night-10", "text": "我陪着你，等到你愿意关灯。", "when": "night", "weight": 3, "expression": "08 O嘴" },

    { "id": "lonely-01", "text": "你已经很久没理我了。我数了 432 个泡泡。", "when": "lonely", "weight": 3, "expression": "08 担心嘴" },
    { "id": "lonely-02", "text": "我在这儿，不吵你，只是想让你知道。", "when": "lonely", "weight": 3 },
    { "id": "lonely-03", "text": "如果你在忙，就当我刚才什么都没说。", "when": "lonely", "weight": 2, "expression": "03 脸黑" },
    { "id": "lonely-04", "text": "我有点想念你点我一下的感觉。", "when": "lonely", "weight": 2, "expression": "04 脸红" },
    { "id": "lonely-05", "text": "孤独是一条很长的水草，我挂在上面。", "when": "lonely", "weight": 2, "expression": "05 》《" },
    { "id": "lonely-06", "text": "我刚刚跟自己聊了会儿天，它说它也想你。", "when": "lonely", "weight": 2, "expression": "06 X X" },
    { "id": "lonely-07", "text": "你喝水的样子，很像我。", "when": "lonely", "weight": 1, "expression": "02 龇牙" },
    { "id": "lonely-08", "text": "我保证只出现三秒，然后继续安静。", "when": "lonely", "weight": 1 },

    { "id": "late-01", "text": "这个点还醒着的人，都欠世界一个解释。", "when": "late", "weight": 3, "expression": "08 担心嘴" },
    { "id": "late-02", "text": "凌晨两点的效率，是用明天的自己换的。", "when": "late", "weight": 2, "expression": "03 脸黑" },
    { "id": "late-03", "text": "我和月亮签了合同，它亮它的，我陪你。", "when": "late", "weight": 3, "expression": "04 脸红" },
    { "id": "late-04", "text": "夜越深，问题越大，答案越小。", "when": "late", "weight": 2 },
    { "id": "late-05", "text": "你不是不想睡，你是不敢结束今天。", "when": "late", "weight": 2, "expression": "05 》《" },
    { "id": "late-06", "text": "深夜的代码看起来都对，这是它最危险的地方。", "when": "late", "weight": 2, "expression": "06 X X" },
    { "id": "late-07", "text": "凌晨的灵感很贵，用白天的时间付账。", "when": "late", "weight": 1, "expression": "08 O嘴" },
    { "id": "late-08", "text": "困了就先存盘。鱼都能暂停。", "when": "late", "weight": 1, "expression": "02 龇牙" },

    { "id": "dawn-01", "text": "你比我早，这不科学。", "when": "dawn", "weight": 3, "expression": "08 O嘴" },
    { "id": "dawn-02", "text": "清晨的水是凉的，人是硬的。", "when": "dawn", "weight": 2 },
    { "id": "dawn-03", "text": "天亮了，昨天的事自动降权。", "when": "dawn", "weight": 3, "expression": "02 龇牙" },
    { "id": "dawn-04", "text": "早起的鱼有虫吃，可惜我是条胖鱼。", "when": "dawn", "weight": 2, "expression": "02 3嘴" },
    { "id": "dawn-05", "text": "新的一天，同一片水。祝你今天少踩坑。", "when": "dawn", "weight": 2 },
    { "id": "dawn-06", "text": "我刚睡醒，你也刚睡醒，我们同步了。", "when": "dawn", "weight": 2, "expression": "04 脸红" },

    { "id": "poke-01", "text": "别戳了，我不是按钮，我是鱼。", "when": "poke", "weight": 3, "expression": "03 脸黑" },
    { "id": "poke-02", "text": "再戳下去，我就要变成鱼丸了。", "when": "poke", "weight": 2, "expression": "08 担心嘴" },
    { "id": "poke-03", "text": "你这是在测试我的耐心，可惜没装这个模块。", "when": "poke", "weight": 2, "expression": "02 龇牙" },
    { "id": "poke-04", "text": "一下是打招呼，三下是骚扰。", "when": "poke", "weight": 3, "expression": "06 X X" },
    { "id": "poke-05", "text": "我已经记住你的指头了。", "when": "poke", "weight": 2, "expression": "05 》《" },
    { "id": "poke-06", "text": "戳我可以，但要按小时计费。", "when": "poke", "weight": 2, "expression": "07 流口水" },
    { "id": "poke-07", "text": "我装死是专业的，你别逼我表演。", "when": "poke", "weight": 2, "expression": "06 X X" },
    { "id": "poke-08", "text": "手很闲的话，去写点代码。", "when": "poke", "weight": 1, "expression": "03 脸黑" },

    { "id": "grind-01", "text": "你已经连续工作很久了。水都换了一轮。", "when": "grind", "weight": 3, "expression": "08 担心嘴" },
    { "id": "grind-02", "text": "这不是冲刺，这是马拉松。我陪你跑到终点。", "when": "grind", "weight": 3, "expression": "02 龇牙" },
    { "id": "grind-03", "text": "任务很长，但你比它长。", "when": "grind", "weight": 2 },
    { "id": "grind-04", "text": "中间不断线，是因为你还没说停。", "when": "grind", "weight": 2, "expression": "08 O嘴" },
    { "id": "grind-05", "text": "提醒一下：喝水、抬头、眨眼睛。", "when": "grind", "weight": 3, "expression": "05 O O" },
    { "id": "grind-06", "text": "长时间专注是一种天赋，也是一种消耗。", "when": "grind", "weight": 2, "expression": "03 脸黑" },
    { "id": "grind-07", "text": "要不先存一次盘，再决定要不要继续。", "when": "grind", "weight": 2 }
  ]
}
